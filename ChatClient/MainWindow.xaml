<Window x:Class="ChatClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ChatClient"
        Title="Socket Group Chat"
        Height="720"
        Width="980"
        Background="#F4F4F6"
        Foreground="#2C2C2C"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Color x:Key="AccentColor">#F36F21</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FF8B4A"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SoftPanelBrush" Color="#F7F7FA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E3E4E8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#2C2C2C"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7C7F88"/>

        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Background="#CFCFD6">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E86018"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D45614"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SoftPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="#FFF3EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFE7D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFFDFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#FFF7F1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#FFEBDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF1E8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="#E8F7ED"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCanceled}" Value="True">
                    <Setter Property="Background" Value="#FFE8E8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <local:FileSizeConverter x:Key="FileSizeConverter"/>
        <local:StickerVisibilityConverter x:Key="StickerVisibilityConverter"/>
        <local:TextVisibilityConverter x:Key="TextVisibilityConverter"/>
        <local:StickerImageConverter x:Key="StickerImageConverter"/>

        <DataTemplate x:Key="TextMessageTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="SenderText"
                           Text="{Binding Sender}"
                           FontWeight="SemiBold"
                           Foreground="#F36F21"
                           Margin="6,0,0,4"/>

                <Border x:Name="Bubble"
                        Grid.Row="1"
                        Background="#FFF7F1"
                        BorderBrush="#FFE1D0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,8"
                        MaxWidth="620"
                        HorizontalAlignment="Left">
                    <Grid>
                        <TextBlock Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   Foreground="#2C2C2C"
                                   Visibility="{Binding Content, Converter={StaticResource TextVisibilityConverter}}"/>
                        <Image Width="150"
                               Height="150"
                               Stretch="Uniform"
                               Source="{Binding Content, Converter={StaticResource StickerImageConverter}}"
                               Visibility="{Binding Content, Converter={StaticResource StickerVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="SenderText" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="SenderText" Property="Foreground" Value="#2D6CDF"/>
                    <Setter TargetName="Bubble" Property="Background" Value="#E8F3FF"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#B6D8FF"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="FileMessageTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="FileSenderText"
                           Text="{Binding Sender}"
                           FontWeight="SemiBold"
                           Foreground="#F36F21"
                           Margin="6,0,0,4"/>

                <Border x:Name="FileBubble"
                        Grid.Row="1"
                        Background="#FFF7F1"
                        BorderBrush="#FFE1D0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,10"
                        MaxWidth="620"
                        HorizontalAlignment="Left">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📄" FontSize="16" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <Border Style="{StaticResource StatusBadgeStyle}">
                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            </Border>
                        </StackPanel>

                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding EtaText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Save"
                                    Width="80"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding IsCompleted}"
                                    Click="SaveFile_Click"
                                    Tag="{Binding}"/>
                            <Button Content="Open"
                                    Width="80"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding IsCompleted}"
                                    Click="OpenFile_Click"
                                    Tag="{Binding}"/>
                            <Button Content="Cancel"
                                    Width="90"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding CanCancel}"
                                    Click="CancelFile_Click"
                                    Tag="{Binding}"/>
                                <Button Content="Retry"
                                    Width="80"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    IsEnabled="{Binding CanRetry}"
                                    Click="RetryFile_Click"
                                    Tag="{Binding}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="FileSenderText" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="FileSenderText" Property="Foreground" Value="#2D6CDF"/>
                    <Setter TargetName="FileBubble" Property="Background" Value="#E8F3FF"/>
                    <Setter TargetName="FileBubble" Property="BorderBrush" Value="#B6D8FF"/>
                    <Setter TargetName="FileBubble" Property="HorizontalAlignment" Value="Right"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                       TextTemplate="{StaticResource TextMessageTemplate}"
                                       FileTemplate="{StaticResource FileMessageTemplate}"/>
    </Window.Resources>

    <Grid Background="#F4F4F6" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Socket Group Chat" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="UsernameBox"
                             Width="220"
                             Height="44"
                             Margin="0,0,10,0"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Tag="Username"
                             VerticalAlignment="Center"/>
                    <Button Content="Set Name"
                            x:Name="SetNameButton"
                            Width="110"
                            Height="44"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SetName_Click"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="LoggedInLabel"
                               Text=""
                               Visibility="Collapsed"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CHAT -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,12">
            <ListBox x:Name="ChatList"
                     Style="{StaticResource ModernListBoxStyle}"
                     ItemsSource="{Binding Messages}"
                     ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                     Margin="4">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>
                </ListBox.Resources>
            </ListBox>
        </Border>

        <!-- EMOJIS -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
            <StackPanel Margin="14,12">
                <TextBlock Text="Reactions" FontSize="11" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="😂" Width="50" Height="36" Margin="4,0" Style="{StaticResource SecondaryButtonStyle}" Click="Emoji_Click"/>
                    <Button Content="😭" Width="50" Height="36" Margin="4,0" Style="{StaticResource SecondaryButtonStyle}" Click="Emoji_Click"/>
                    <Button Content="🔥" Width="50" Height="36" Margin="4,0" Style="{StaticResource SecondaryButtonStyle}" Click="Emoji_Click"/>
                    <Button Content="❤️" Width="50" Height="36" Margin="4,0" Style="{StaticResource SecondaryButtonStyle}" Click="Emoji_Click"/>
                    <Button Content="👍" Width="50" Height="36" Margin="4,0" Style="{StaticResource SecondaryButtonStyle}" Click="Emoji_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- STICKERS -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,10">
            <StackPanel Margin="14,12">
                <TextBlock Text="Stickers" FontSize="11" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="Frog" Width="130" Height="40" Margin="4,0" Tag="frog" Style="{StaticResource SecondaryButtonStyle}" Click="Sticker_Click"/>
                    <Button Content="Cute" Width="130" Height="40" Margin="4,0" Tag="cute" Style="{StaticResource SecondaryButtonStyle}" Click="Sticker_Click"/>
                    <Button Content="Heart" Width="130" Height="40" Margin="4,0" Tag="heart" Style="{StaticResource SecondaryButtonStyle}" Click="Sticker_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- SEND -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Height="48"
                         Margin="0,0,10,0"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Tag="Type a message..."
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Send File"
                        Width="120"
                        Height="48"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SendFile_Click"
                        VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="Send"
                        Width="120"
                        Height="48"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Send_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
